# This package has no runtime dependencies and no build step: it is plain ESM
# plus a browser half, installed straight from a Git commit. npm is therefore
# only ever used here for `npm pack` (the release tarball), and CI runs `node`
# directly.
#
# `legacy-peer-deps` follows the upstream dsh-rewind convention this package is
# modelled on; it is harmless with zero peers and keeps a future local
# `npm install` from resolving the profile's pnpm-managed tree.
legacy-peer-deps=true

# Do not run audits or funding lookups in CI: they need the registry, and a
# release job must not fail because the registry is unreachable.
fund=false
audit=false
package-lock=false
